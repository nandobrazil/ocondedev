---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada — oconde.dev" description="Esta página não existe em oconde.dev.">
  <section class="container not-found">
    <p class="code gradient-text">404</p>
    <h1>Não achei essa página.</h1>
    <p class="lead">O endereço pode ter mudado. O que existe aqui está na lista de projetos e na página inicial.</p>
    <p class="actions">
      <a class="btn" href="/">Início</a>
      <a class="btn ghost" href="/projetos/">Projetos</a>
    </p>
  </section>
</Base>

<style>
  .not-found {
    padding-block: 6rem 4rem;
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    text-align: center;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(6rem, 20vw, 11rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .not-found h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
  }

  .lead {
    margin-inline: auto;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
