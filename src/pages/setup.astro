---
import Base from '../layouts/Base.astro';
import { setupSections } from '../data/setup';
---

<Base title="Setup — Fernando Conde" description="O hardware e as ferramentas que Fernando Conde usa para trabalhar todo dia.">
  <section class="container page-head">
    <p class="pill brand">Na mesa, hoje</p>
    <h1>Com o que eu <span class="gradient-text">trabalho</span></h1>
    <p class="lead">Hardware e ferramentas do dia a dia. Nada patrocinado; é o que está na mesa.</p>
  </section>
  <div class="container sections">
    {
      setupSections.map((section) => (
        <section class="group reveal">
          <h2>{section.title}</h2>
          <dl>
            {section.items.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>
                  {item.link ? (
                    <a href={item.link} target="_blank" rel="noopener">
                      {item.value} <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    item.value
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .sections {
    display: grid;
    gap: 1.25rem;
  }

  .group {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-large);
    background: var(--card);
  }

  h2 {
    font-size: 1.5rem;
    letter-spacing: -0.03em;
  }

  dl {
    display: grid;
  }

  dl div {
    display: grid;
    gap: 0.15rem 2rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--line);
  }

  dt {
    font-size: 0.875rem;
    color: var(--ink-mute);
  }

  dd {
    font-weight: 500;
  }

  dd a {
    transition: color 0.15s ease;
  }

  dd a:hover {
    color: var(--link);
  }

  dd a span {
    color: var(--ink-mute);
    font-size: 0.8em;
  }

  @media (min-width: 48rem) {
    .group {
      padding: 2rem 2.25rem;
    }

    dl div {
      grid-template-columns: 11rem 1fr;
    }
  }

  @media (min-width: 64rem) {
    .sections {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
</style>
