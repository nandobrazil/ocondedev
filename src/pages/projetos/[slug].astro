---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import StatusPill from '../../components/StatusPill.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import ProjectList from '../../components/ProjectList.astro';
import Section from '../../components/Section.astro';
import { categoryLabel, projectHost, relatedProjects, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project, projects } }));
}

interface Props {
  project: Project;
  projects: Project[];
}

const { project, projects } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const og = await getImage({ src: data.cover, width: 1200, height: 630, format: 'jpeg' });
const related = relatedProjects(projects, project);
---

<Base title={`${data.ogTitle ?? data.name} — Fernando Conde`} description={data.tagline} ogImage={og.src} ogType="article">
  <article>
    <header class="container head">
      <div class="meta">
        <p class="crumbs"><a href="/projetos/">Projetos</a> <span aria-hidden="true">/</span> {categoryLabel[data.category]}</p>
        <StatusPill status={data.status} />
      </div>
      <h1>{data.name}</h1>
      <p class="lead">{data.tagline}</p>
      <ProjectLinks project={project} size="regular" />
    </header>

    <div class="container">
    <div class:list={['shots', { 'with-mobile': Boolean(data.mobile) }]}>
      <Shot
        src={data.cover}
        srcLight={data.coverLight}
        alt={`Tela do ${data.name} no desktop`}
        widths={[720, 1080, 1440]}
        sizes="(min-width: 76rem) 76rem, 100vw"
        loading="eager"
      />
      {
        data.mobile && (
          <Shot
            src={data.mobile}
            srcLight={data.mobileLight}
            alt={`Tela do ${data.name} no celular`}
            widths={[390, 780]}
            sizes="16rem"
            loading="eager"
            variant="phone"
          />
        )
      }
    </div>
    </div>

    <div class="container body">
      <div class="prose">
        <Content />
      </div>
      <aside class="side">
        <p class="eyebrow">Ficha</p>
        <dl class="facts">
          <div><dt>Situação</dt><dd><StatusPill status={data.status} /></dd></div>
          <div><dt>Período</dt><dd>{data.period}</dd></div>
          <div><dt>Papel</dt><dd>{data.role}</dd></div>
          <div><dt>Onde</dt><dd class="mono">{projectHost(project)}</dd></div>
          <div><dt>Stack</dt><dd>{data.stack.join(', ')}</dd></div>
        </dl>
      </aside>
    </div>

    {
      data.gallery.length > 0 && (
        <div class="container gallery">
          {data.gallery.map((shot) => (
            <Shot src={shot.src} alt={shot.caption} widths={[720, 1080]} sizes="(min-width: 76rem) 37rem, 100vw" caption={shot.caption} />
          ))}
        </div>
      )
    }
  </article>

  <Section eyebrow="Continue vendo" title="Mais projetos">
    <ProjectList projects={related} />
  </Section>
</Base>

<style>
  .head {
    display: grid;
    gap: 1.25rem;
    padding-block: 3.5rem 2.5rem;
    justify-items: start;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .crumbs {
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--card);
    border: 1px solid var(--line);
    color: var(--ink-mute);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .crumbs a {
    color: var(--ink);
  }

  .crumbs a:hover {
    color: var(--link);
  }

  .crumbs span {
    margin-inline: 0.3rem;
  }

  .head h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
  }

  .head :global(.links) {
    margin-top: 0.5rem;
  }

  .shots {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: 1rem;
    border-radius: var(--radius-large);
    background: var(--band);
  }

  .shots :global(.frame) {
    box-shadow: var(--shadow-app);
  }

  .shots :global(.phone) {
    margin-inline: auto;
  }

  .body {
    display: grid;
    gap: 2.5rem;
    padding-block: 3rem;
  }

  .side {
    align-self: start;
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-large);
    background: var(--card);
  }

  .side .facts {
    grid-template-columns: 5.5rem 1fr;
  }

  .side .facts > div:first-child dt,
  .side .facts > div:first-child dd {
    border-top: 0;
  }

  .gallery {
    display: grid;
    gap: 2.5rem 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    padding-top: 1rem;
  }

  @media (min-width: 48rem) {
    .shots {
      padding: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .with-mobile {
      grid-template-columns: 1fr 15rem;
      gap: 2.5rem;
    }

    .shots {
      padding: 3rem;
    }

    .body {
      grid-template-columns: minmax(0, var(--measure)) minmax(16rem, 22rem);
      justify-content: space-between;
      gap: 5rem;
      padding-block: 4.5rem;
    }

    .side {
      position: sticky;
      top: 5.5rem;
    }
  }
</style>
