---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CompanyStrip from '../components/CompanyStrip.astro';
import StatsBand from '../components/StatsBand.astro';
import Section from '../components/Section.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SkillGroups from '../components/SkillGroups.astro';
import Timeline from '../components/Timeline.astro';
import ContactCta from '../components/ContactCta.astro';
import { profile } from '../data/profile';
import { experience } from '../data/experience';
import { featuredProjects } from '../lib/projects';

const featured = featuredProjects(await getCollection('projects'));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Curitiba', addressRegion: 'PR', addressCountry: 'BR' },
  url: 'https://oconde.dev',
  sameAs: [profile.links.github, profile.links.linkedin],
};
---

<Base
  title="Fernando Conde — Engenheiro de software full-stack"
  description="Fernando Conde, engenheiro de software full-stack em Curitiba. Produtos completos do banco ao deploy: Angular, .NET, Node, SvelteKit, Go, Kubernetes, dois apps na App Store e agentes de IA."
  jsonLd={jsonLd}
>
  <Hero projects={featured} />
  <CompanyStrip />
  <StatsBand />

  <Section
    id="destaque"
    eyebrow="Em destaque"
    title="Construído e operado de ponta a ponta"
    lead="Sete coisas no ar hoje que eu construí inteiras: produto, código, infra e operação."
    align="center"
  >
    <div class="cards">
      {featured.map((project, index) => <ProjectRow project={project} index={index} />)}
    </div>
    <p class="more">
      <a class="btn ghost" href="/projetos/">Ver todos os projetos <span class="arrow" aria-hidden="true">→</span></a>
    </p>
  </Section>

  <SkillGroups
    title="O que eu uso, e onde está rodando"
    lead="Agrupado por área, com o quanto uso cada coisa e onde ela está em uso de verdade."
  />

  <Section
    id="trajetoria"
    eyebrow="Trajetória"
    title="Onze anos, cinco setores"
    lead="Setor público, saúde, banco, logística e a minha própria consultoria."
  >
    <Timeline jobs={experience.slice(0, 5)} compact />
    <p class="more start">
      <a class="btn ghost" href="/experiencia/">Experiência completa <span class="arrow" aria-hidden="true">→</span></a>
    </p>
  </Section>

  <ContactCta />
</Base>

<style>
  .cards {
    display: grid;
    gap: 1.25rem;
  }

  .more {
    display: flex;
    justify-content: center;
    padding-top: 2rem;
  }

  .more.start {
    justify-content: flex-start;
  }
</style>
