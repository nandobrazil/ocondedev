---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
---

<Base title="Contato — Fernando Conde" description="Fale com Fernando Conde por e-mail, LinkedIn ou GitHub.">
  <section class="container page-head">
    <p class="pill brand">{profile.city}</p>
    <h1>Vamos <span class="gradient-text">conversar</span></h1>
    <p class="lead">
      Projeto, consultoria, uma vaga ou só uma dúvida sobre algo que está aqui. Respondo por e-mail, geralmente no mesmo
      dia.
    </p>
  </section>
  <dl class="container channels">
    <div>
      <dt>E-mail</dt>
      <dd>
        <a class="value" href={`mailto:${profile.email}`}>{profile.email}</a>
        <button class="btn small copy" type="button" data-copy={profile.email}>Copiar e-mail</button>
      </dd>
    </div>
    <div>
      <dt>LinkedIn</dt>
      <dd>
        <a class="value" href={profile.links.linkedin} target="_blank" rel="noopener">linkedin.com/in/nandobrazil</a>
      </dd>
    </div>
    <div>
      <dt>GitHub</dt>
      <dd>
        <a class="value" href={profile.links.github} target="_blank" rel="noopener">github.com/nandobrazil</a>
      </dd>
    </div>
  </dl>
  <p class="toast" id="toast" role="status" aria-live="polite"></p>
</Base>

<script>
  const toast = document.getElementById('toast');
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        if (toast) {
          toast.textContent = 'E-mail copiado';
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2000);
        }
      } catch (error) {
        if (toast) toast.textContent = 'Não deu para copiar; selecione o e-mail';
      }
    });
  });
</script>

<style>
  .channels {
    display: grid;
    gap: 0.75rem;
  }

  .channels > div {
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-large);
    background: var(--card);
    transition: border-color 0.2s ease;
  }

  .channels > div:hover {
    border-color: var(--line-strong);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--ink-display);
    overflow-wrap: anywhere;
    transition: color 0.15s ease;
  }

  .value:hover {
    color: var(--link);
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    transform: translate(-50%, 1rem);
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--button);
    color: var(--on-button);
    font-weight: 600;
    font-size: 0.875rem;
    opacity: 0;
    transition:
      opacity 0.2s ease,
      transform 0.3s var(--ease-settle);
    pointer-events: none;
  }

  .toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (min-width: 48rem) {
    .channels > div {
      grid-template-columns: 9rem 1fr;
      gap: 2rem;
      align-items: center;
      padding: 2rem 2.25rem;
    }
  }
</style>
