---
import type { Job } from '../data/experience';
import { stackColor } from '../lib/stack';

interface Props {
  jobs: Job[];
  compact?: boolean;
}

const { jobs, compact = false } = Astro.props;
---

<ol class:list={['jobs', 'reveal', { compact }]}>
  {
    jobs.map((job, index) => (
      <li class:list={{ current: index === 0 && job.period.includes('hoje') }}>
        <span class="logo" style={`--logo: ${stackColor(job.company)}`} aria-hidden="true">
          {job.company[0]}
        </span>
        <div class="content">
          <div class="title">
            <h3>{job.company}</h3>
            {index === 0 && job.period.includes('hoje') && <span class="pill brand">Atual</span>}
          </div>
          <p class="role">{job.role}</p>
          {compact ? (
            <p class="summary">{job.summary}</p>
          ) : (
            <>
              <p class="summary">{job.summary}</p>
              <ul class="bullets">
                {job.bullets.map((bullet) => (
                  <li>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12.5l4.5 4.5L19 7.5" />
                    </svg>
                    {bullet}
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
        <div class="when">
          <p class="period mono">{job.period}</p>
          <p class="where">{job.location} · {job.type}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .jobs {
    border: 1px solid var(--line);
    border-radius: var(--radius-large);
    background: var(--canvas);
    overflow: hidden;
  }

  .jobs > li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem 1rem;
    padding: 1.5rem 1.25rem;
    transition: background-color 0.15s ease;
  }

  .jobs > li + li {
    border-top: 1px solid var(--line);
  }

  .jobs > li:hover {
    background: var(--card);
  }

  .logo {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 11px;
    background: color-mix(in srgb, var(--logo) 14%, var(--canvas));
    color: var(--logo);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.0625rem;
  }

  .content {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  h3 {
    font-size: 1.25rem;
  }

  .role {
    font-weight: 600;
    color: var(--ink);
  }

  .summary {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    text-wrap: pretty;
  }

  .bullets {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
    max-width: var(--measure);
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .bullets li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    text-wrap: pretty;
  }

  .bullets svg {
    flex: none;
    margin-top: 0.2rem;
    color: var(--link);
  }

  .when {
    grid-column: 2;
    display: grid;
    gap: 0.15rem;
    color: var(--ink-mute);
    font-size: 0.8125rem;
  }

  .period {
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 500;
  }

  @media (min-width: 48rem) {
    .jobs > li {
      grid-template-columns: auto minmax(0, 1fr) 17rem;
      gap: 1.25rem;
      padding: 1.75rem;
    }

    .when {
      grid-column: 3;
      grid-row: 1;
      text-align: right;
      align-content: start;
      padding-top: 0.2rem;
    }

    .compact > li {
      padding-block: 1.25rem;
    }
  }
</style>
