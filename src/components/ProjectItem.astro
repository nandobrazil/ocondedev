---
import Shot from './Shot.astro';
import StatusDot from './StatusDot.astro';
import ProjectLinks from './ProjectLinks.astro';
import { type Project } from '../lib/projects';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { data } = project;
const href = `/projetos/${project.id}/`;
const search = [data.name, data.tagline, ...data.stack].join(' ').toLowerCase();
---

<article class="project card" data-category={data.category} data-search={search}>
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
    <Shot
      src={data.cover}
      alt={`Tela do ${data.name}`}
      widths={[480, 720, 960]}
      sizes="(min-width: 48rem) 28rem, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      variant="thumb"
    />
  </a>
  <div class="body">
    <div class="title-row">
      <h3><a href={href}>{data.name}</a></h3>
      <StatusDot status={data.status} />
    </div>
    <p class="tagline">{data.tagline}</p>
    <ul class="tags">
      {data.stack.slice(0, 4).map((item) => <li class="tag">{item}</li>)}
      {data.stack.length > 4 && <li class="tag">+{data.stack.length - 4}</li>}
    </ul>
    <ProjectLinks project={project} />
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    gap: 0.25rem;
  }

  .project[hidden] {
    display: none;
  }

  .project:hover {
    border-color: var(--accent);
  }

  .thumb :global(.frame) {
    border-color: var(--line);
  }

  .body {
    display: grid;
    gap: 0.75rem;
    padding: 1rem 0.75rem 0.75rem;
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .tagline {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    text-wrap: pretty;
  }
</style>
