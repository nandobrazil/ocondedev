---
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import radarCover from '../content/projects/radar/desktop.webp';
import trediMobile from '../content/projects/tredi/mobile.webp';
import trediMobileLight from '../content/projects/tredi/mobile-light.webp';
import arvoredeCover from '../content/projects/arvorede-link/desktop.webp';
---

<section class="hero">
  <div class="container grid">
    <div class="text">
      <p class="badge">{profile.title} · {profile.city}</p>
      <h1>{profile.name}</h1>
      <p class="lead">{profile.intro[0]}</p>
      <p class="secondary">{profile.intro[1]}</p>
      <div class="actions">
        <a class="btn" href="/projetos/">Ver projetos <span class="arrow">→</span></a>
        <a class="btn ghost" href="/contato/">Contato</a>
      </div>
      <ul class="facts" aria-label="Números">
        {profile.stats.map((stat) => <li><strong>{stat.value}</strong> {stat.label}</li>)}
      </ul>
    </div>
    <div class="mockup" aria-hidden="true">
      <div class="screen back">
        <Image src={arvoredeCover} alt="" widths={[640, 960]} sizes="(min-width: 60rem) 34rem, 90vw" loading="eager" />
      </div>
      <div class="screen front">
        <Image src={radarCover} alt="" widths={[640, 960]} sizes="(min-width: 60rem) 34rem, 90vw" loading="eager" />
      </div>
      <div class="phone">
        <Image class="only-dark" src={trediMobile} alt="" widths={[300, 600]} sizes="9rem" loading="eager" />
        <Image class="only-light" src={trediMobileLight} alt="" widths={[300, 600]} sizes="9rem" loading="eager" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: 4rem 3rem;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(42rem 26rem at 85% 10%, var(--glow-1), transparent 65%),
      radial-gradient(30rem 22rem at 10% 90%, var(--glow-2), transparent 70%);
    pointer-events: none;
  }

  .grid {
    position: relative;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .text {
    display: grid;
    gap: 1.25rem;
  }

  .secondary {
    color: var(--ink-soft);
    max-width: 38rem;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .facts strong {
    color: var(--ink);
    font-weight: 700;
  }

  .mockup {
    position: relative;
    display: none;
    aspect-ratio: 5 / 4;
  }

  .screen {
    position: absolute;
    width: 86%;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .screen :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  .back {
    top: 0;
    right: 0;
    opacity: 0.75;
    transform: scale(0.94);
    transform-origin: top right;
  }

  .front {
    top: 14%;
    left: 0;
  }

  .phone {
    position: absolute;
    right: 6%;
    bottom: 0;
    width: 24%;
    border: 1px solid var(--line-strong);
    border-radius: 1.4rem;
    padding: 0.3rem;
    background: var(--surface-raised);
    box-shadow: var(--shadow);
  }

  .phone :global(img) {
    width: 100%;
    height: auto;
    border-radius: 1.1rem;
  }

  @media (min-width: 60rem) {
    .hero {
      padding-block: 5.5rem 4.5rem;
    }

    .grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 4rem;
    }

    .mockup {
      display: block;
    }
  }
</style>
