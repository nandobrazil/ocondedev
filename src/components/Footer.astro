---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container row mono">
    <p>© {year} {profile.name} · {profile.city}</p>
    <ul class="links">
      <li><a href={profile.links.github} rel="noopener" target="_blank">GitHub</a></li>
      <li><a href={profile.links.linkedin} rel="noopener" target="_blank">LinkedIn</a></li>
      <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
      <li><a href={profile.links.tools} rel="noopener" target="_blank">tools.oconde.dev</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 6rem;
    padding-block: 1.75rem;
    color: var(--ink-soft);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .links a {
    text-decoration: none;
  }

  .links a:hover {
    color: var(--ink);
  }
</style>
