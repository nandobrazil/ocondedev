---
import { linkLabel, type Project } from '../lib/projects';

interface Props {
  project: Project;
  size?: 'small' | 'regular';
}

const { project, size = 'small' } = Astro.props;
const links = Object.entries(project.data.links).filter(([, url]) => url) as [keyof typeof linkLabel, string][];
---

{
  links.length > 0 && (
    <div class:list={['links', size]}>
      {links.map(([key, url], index) =>
        size === 'regular' ? (
          <a class:list={['btn', { ghost: index > 0 }]} href={url} target="_blank" rel="noopener">
            {linkLabel[key]}
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          <a class="text-link" href={url} target="_blank" rel="noopener">
            {linkLabel[key]} <span aria-hidden="true">↗</span>
          </a>
        ),
      )}
    </div>
  )
}

<style>
  .links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    font-size: 0.875rem;
  }

  .regular {
    gap: 0.6rem;
  }
</style>
