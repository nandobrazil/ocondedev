---
import Shot from './Shot.astro';
import StatusPill from './StatusPill.astro';
import ProjectLinks from './ProjectLinks.astro';
import { categoryLabel, projectHost, type Project } from '../lib/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;
const href = `/projetos/${project.id}/`;
---

<article class:list={['card', 'reveal', { flip: index % 2 === 1 }]}>
  <div class="text">
    <div class="meta">
      <span class="pill">{categoryLabel[data.category]}</span>
      <StatusPill status={data.status} />
    </div>
    <h3><a href={href}>{data.name}</a></h3>
    <p class="tagline">{data.tagline}</p>
    <ul class="stack" aria-label="Stack">
      {data.stack.slice(0, 6).map((item) => <li>{item}</li>)}
    </ul>
    <div class="actions">
      <a class="btn small" href={href}>Ver o projeto <span class="arrow" aria-hidden="true">→</span></a>
      <ProjectLinks project={project} />
    </div>
    <p class="host mono">{projectHost(project)} · {data.period}</p>
  </div>
  <a class="visual" href={href} tabindex="-1" aria-hidden="true">
    <Shot
      src={data.cover}
      srcLight={data.coverLight}
      alt={`Tela do ${data.name}`}
      widths={[640, 960, 1280]}
      sizes="(min-width: 64rem) 40rem, 100vw"
      loading={index < 2 ? 'eager' : 'lazy'}
      variant="thumb"
    />
  </a>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    border: 1px solid var(--line);
    border-radius: var(--radius-large);
    background: var(--card);
    overflow: hidden;
    transition: border-color 0.25s ease;
  }

  .card:hover {
    border-color: var(--line-strong);
  }

  .text {
    display: grid;
    gap: 1rem;
    align-content: center;
    justify-items: start;
    padding: 1.75rem 1.5rem 0.5rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  h3 {
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  h3 a {
    transition: color 0.15s ease;
  }

  h3 a:hover {
    color: var(--link);
  }

  .tagline {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-soft);
    text-wrap: pretty;
    max-width: 30rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .stack li {
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--canvas);
    border: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.5rem;
  }

  .host {
    color: var(--ink-mute);
    font-size: 0.75rem;
  }

  .visual {
    display: block;
    padding: 1.5rem 0 0 1.5rem;
  }

  .visual :global(.frame) {
    border-radius: var(--radius-card) 0 0 0;
    border-right: 0;
    border-bottom: 0;
    box-shadow: var(--shadow-app);
    transition: transform 0.45s var(--ease-settle);
  }

  .card:hover .visual :global(.frame) {
    transform: translate(-6px, -6px);
  }

  @media (min-width: 64rem) {
    .card {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      min-height: 30rem;
    }

    .text {
      padding: 3.5rem 1rem 3.5rem 3.5rem;
    }

    .visual {
      align-self: end;
      padding: 3.5rem 0 0 2rem;
    }

    .flip .text {
      order: 2;
      padding: 3.5rem 3.5rem 3.5rem 1rem;
    }

    .flip .visual {
      padding: 3.5rem 2rem 0 0;
    }

    .flip .visual :global(.frame) {
      border-radius: 0 var(--radius-card) 0 0;
      border-right: 1px solid var(--line);
      border-left: 0;
    }

    .flip:hover .visual :global(.frame) {
      transform: translate(6px, -6px);
    }
  }
</style>
