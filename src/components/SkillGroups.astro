---
import { levelLabel, skillGroups, type SkillLevel } from '../data/skills';

interface Props {
  title: string;
  lead: string;
}

const { title, lead } = Astro.props;
const levelWeight: Record<SkillLevel, number> = { daily: 3, solid: 2, used: 1 };
---

<section class="container" id="stack">
  <div class="panel reveal">
    <header class="head">
      <p class="eyebrow">Stack</p>
      <h2>{title}</h2>
      <p class="lead">{lead}</p>
      <ul class="legend" aria-label="Legenda">
        {
          (['daily', 'solid', 'used'] as SkillLevel[]).map((level) => (
            <li class:list={['level-pill', level]}>
              <span class="bars" aria-hidden="true">
                {[1, 2, 3].map((step) => (
                  <i class:list={{ on: step <= levelWeight[level] }} />
                ))}
              </span>
              {levelLabel[level]}
            </li>
          ))
        }
      </ul>
    </header>
    <div class="groups">
      {
        skillGroups.map((group) => (
          <section class="group">
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((skill) => (
                <li>
                  <div class="row">
                    <strong>{skill.name}</strong>
                    <span class="bars" title={levelLabel[skill.level]}>
                      <span class="visually-hidden">{levelLabel[skill.level]}</span>
                      {[1, 2, 3].map((step) => (
                        <i class:list={{ on: step <= levelWeight[skill.level] }} aria-hidden="true" />
                      ))}
                    </span>
                  </div>
                  <p>{skill.note}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .panel {
    --on-panel: #ffffff;
    --on-panel-soft: #b3b3b3;
    --on-panel-mute: #838383;
    position: relative;
    margin-top: 5rem;
    padding: 3rem 1.25rem 1.25rem;
    border-radius: var(--radius-large);
    background: var(--panel-fade);
    color: var(--on-panel);
    overflow: hidden;
    isolation: isolate;
  }

  .panel::before {
    content: '';
    position: absolute;
    inset: -30% 10% auto;
    height: 28rem;
    background: radial-gradient(closest-side, rgba(118, 18, 250, 0.35), transparent);
    filter: blur(30px);
    z-index: -1;
  }

  .head {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .head h2 {
    color: var(--on-panel);
    font-weight: 650;
    max-width: 16ch;
  }

  .head .lead {
    color: var(--on-panel-soft);
  }

  .eyebrow {
    color: #a99bff;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .level-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--panel-line);
    color: var(--on-panel-soft);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .groups {
    columns: 1;
    column-gap: 0.75rem;
  }

  .group {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.5rem;
    margin-bottom: 0.75rem;
    break-inside: avoid;
    border-radius: var(--radius-card);
    border: 1px solid var(--panel-line);
    background: rgba(255, 255, 255, 0.03);
  }

  h3 {
    color: var(--on-panel);
    font-size: 1.125rem;
  }

  .group ul {
    display: grid;
  }

  .group li {
    display: grid;
    gap: 0.2rem;
    padding-block: 0.7rem;
    border-top: 1px solid var(--panel-line);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  strong {
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .bars {
    display: inline-flex;
    gap: 3px;
  }

  .bars i {
    width: 0.85rem;
    height: 0.3rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.14);
  }

  .bars i.on {
    background: linear-gradient(90deg, #40ddff, #7612fa);
  }

  .group p {
    color: var(--on-panel-mute);
    font-size: 0.875rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (min-width: 48rem) {
    .panel {
      padding: 4.5rem 2rem 2rem;
    }

    .groups {
      columns: 2;
    }
  }

  @media (min-width: 64rem) {
    .panel {
      margin-top: 7rem;
      padding: 6rem 3rem 3rem;
    }

    .head {
      margin-bottom: 3.5rem;
    }

    .groups {
      columns: 3;
    }
  }
</style>
