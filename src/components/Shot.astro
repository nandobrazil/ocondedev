---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  srcLight?: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: 'lazy' | 'eager';
  caption?: string;
  variant?: 'default' | 'phone' | 'thumb';
}

const { src, srcLight, alt, widths, sizes, loading = 'lazy', caption, variant = 'default' } = Astro.props;
---

<figure class:list={['shot', variant]}>
  <div class="frame">
    <Image class:list={[{ 'only-dark': srcLight }]} src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
    {srcLight && <Image class="only-light" src={srcLight} alt={alt} widths={widths} sizes={sizes} loading={loading} />}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot :global(img) {
    width: 100%;
    height: auto;
  }

  .thumb :global(img) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }

  .phone {
    max-width: 16rem;
  }

  .phone .frame {
    border-radius: 2.25rem;
    padding: 0.45rem;
    background: var(--ink-display);
    border-color: var(--ink-display);
    box-shadow: var(--shadow-app);
  }

  .phone :global(img) {
    border-radius: 1.8rem;
  }

  figcaption {
    margin-top: 0.85rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 32rem;
    text-wrap: pretty;
  }
</style>
