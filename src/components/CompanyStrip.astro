---
import { experience } from '../data/experience';

const companies = [...new Set(experience.map((job) => job.company))];
---

<section class="strip container" aria-labelledby="strip-title">
  <p class="eyebrow" id="strip-title">Onde já trabalhei</p>
  <ul>
    {companies.map((company) => <li>{company}</li>)}
  </ul>
</section>

<style>
  .strip {
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    padding-block: 1rem 0.5rem;
    text-align: center;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2.75rem;
  }

  li {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 2vw, 1.375rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--ink-mute);
    opacity: 0.85;
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  li:hover {
    color: var(--ink);
    opacity: 1;
  }
</style>
